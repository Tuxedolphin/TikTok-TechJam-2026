# Egress enforcement: agent containers get no route off-box and reach the
# network only through a proxy that authorizes every connection against the
# grants you issue. Set to "off" to restore plain bridge networking.
EGRESS_ENFORCEMENT=on
# EGRESS_QUARANTINE_THRESHOLD=3

# Browser/server. The local POC stays on loopback without authentication;
# Docker Compose overrides HOST to 0.0.0.0 and bootstrap-local.sh generates a token.
HOST=127.0.0.1
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
APP_AUTH_TOKEN=

# Select exactly one model provider: gemini, openrouter, or ark. A single
# configured provider is auto-detected; set this explicitly when credentials
# for more than one provider are present.
# MODEL_PROVIDER=openrouter

# Option A: Google Gemini through the authenticated internal adapter.
# MODEL_PROVIDER=gemini
# The server generates a dedicated Runtime-to-adapter token on startup. Set a
# URL-safe value of at least 24 characters only when a stable token is required.
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_ADAPTER_TOKEN=replace-with-a-dedicated-runtime-token

# Option B: OpenRouter. OPENROUTER_MODEL is an OpenRouter model slug such as
# openai/gpt-4o-mini or anthropic/claude-3.5-sonnet.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Option C: BytePlus ModelArk Responses API.
# MODEL_PROVIDER=ark
# ARK_API_KEY=replace-with-your-ark-api-key
# ARK_MODEL=ep-your-endpoint-id
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
CODEX_HOME=/app/codex-home
CODEX_BIN=codex

# Codex runs inside the dedicated ECS/container boundary. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Runtime provider also selects Gemini adapter reachability. ECS/Compose uses
# local-process and loopback because Codex is installed in the application
# container. scripts/start-local-poc.sh uses container plus the explicit
# host.docker.internal host-gateway mapping for Docker/Colima/Podman.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES="ca-certificates git ripgrep curl"
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000

# Output and duration limits are preventive. Input and total limits are
# observational checks after provider usage arrives. Cached input is reported
# as a subset of input and is not added again when calculating total tokens.
# RUN_BUDGET_MAX_INPUT_TOKENS=100000
# RUN_BUDGET_MAX_OUTPUT_TOKENS=4096
# RUN_BUDGET_MAX_TOTAL_TOKENS=104096
# RUN_BUDGET_MAX_DURATION_MS=600000
